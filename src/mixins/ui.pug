mixin btn(label, href, variant='primary')
  a.btn(class=`btn--${variant}` href=href)&attributes(attributes)= label

mixin icon(name)
  svg.icon(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true')
    case name
      when 'monitor'
        rect(x='3' y='4' width='18' height='13' rx='1')
        path(d='M8 21h8M12 17v4')
      when 'pen'
        path(d='m4 20 4-1 12-12-3-3L5 16zM15 6l3 3')
      when 'layers'
        path(d='m12 2 10 6-10 6L2 8zM2 12l10 6 10-6M2 16l10 6 10-6')
      when 'play'
        circle(cx='12' cy='12' r='10')
        path(d='m10 8 6 4-6 4z')
      default
        circle(cx='12' cy='12' r='9')

mixin picture(name, alt, cssClass='', eager=false)
  picture
    source(type='image/avif' srcset=`${imageRoot}/${name}-400.avif 400w, ${imageRoot}/${name}-800.avif 800w` sizes='(min-width: 1280px) 357px, (min-width: 768px) 50vw, 100vw')
    source(type='image/webp' srcset=`${imageRoot}/${name}-400.webp 400w, ${imageRoot}/${name}-800.webp 800w` sizes='(min-width: 1280px) 357px, (min-width: 768px) 50vw, 100vw')
    img(class=cssClass src=`${imageRoot}/${name}-800.jpg` alt=alt width='800' height='640' decoding='async' loading=eager ? undefined : 'lazy' fetchpriority=eager ? 'high' : undefined)

mixin work-card(work)
  article.work-card(data-category=work.category tabindex='0')
    +picture(work.image, `${work.title} — portfolio artwork`, 'work-card__image')
    .work-card__overlay
      span.work-card__plus(aria-hidden='true') +
      h3.work-card__title= work.title
      span.work-card__category= work.category

mixin panel(title)
  section.panel
    h2.panel__title= title
    block
